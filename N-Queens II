class Solution {
public:
    bool isPossible(int row,int col,vector<string>&vis,int n){
        int r=row;
        int c=col;
        while(r>=0 && c>=0){
            if(vis[r][c]=='Q') return false;
            r--;
            c--;
        }
        c=col;
        r=row;
        while(c>=0){
            if(vis[r][c]=='Q') return false;
            c--;
        }
        r=row;
        c=col;
        while(r<n && c>=0){
            if(vis[r][c]=='Q') return false;
            r++;
            c--;
        }
        return true;
    }
    int solve(int n,int col,vector<string>&vis){
        int count=0;
        if(col==n){
            return 1;
        }
        for(int row=0;row<n;row++){
            if(isPossible(row,col,vis,n)){
                vis[row][col]='Q';
                count+=solve(n,col+1,vis);
                vis[row][col]='.';
            }
        }
        return count;
    }

    int totalNQueens(int n) {
        vector<string>temp(n);
        string s(n,'.');
        for(int i=0;i<n;i++){
            temp[i]=s;
        }
        return solve(n,0,temp);
    }
};
