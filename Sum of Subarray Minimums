class Solution {
public:
    const int mod=(int) 1e9+7;
    int sumSubarrayMins(vector<int>& arr) {
        int n=arr.size();
        vector<int>prevSmallerAndEqual(n);
        vector<int>nextSmaller(n);
        stack<int>s;
        stack<int>s2;
        int ans=0;
        s.push(-1);
        s2.push(-1);
        for(int i=n-1;i>=0;i--){
            while(s.top()!=-1 && arr[i]<=arr[s.top()]){
                s.pop();
            }
            if(s.top()==-1){
                nextSmaller[i]=n;
            }
            else{
                nextSmaller[i]=s.top();
            }
            s.push(i);
        }
        for(int i=0;i<n;i++){
            while(s2.top()!=-1 && arr[i]<arr[s2.top()]){
                s2.pop();
            }
            prevSmallerAndEqual[i]=s2.top();
            s2.push(i);
        }
        for(int i=0;i<arr.size();i++){
            int next=nextSmaller[i]-i;
            int prev=i-prevSmallerAndEqual[i];
            ans = (ans + (arr[i] * 1LL * next % mod * prev % mod)) % mod;
        }
        return ans;
    }
};
