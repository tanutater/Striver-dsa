class Solution {
public:
    bool solveMem(string s, unordered_map<string,bool>& mp,
                  int idx, vector<int>& dp) {

        if(idx >= s.size()) return true;

        if(dp[idx] != -1) return dp[idx];

        for(int i = idx; i < s.size(); i++) {
            string word = s.substr(idx, i - idx + 1);

            if(mp[word] == true && solveMem(s, mp, i + 1, dp)) {
                dp[idx] = 1;
                return true;
            }
        }

        return dp[idx] = 0;
    }

    bool solve(string s, unordered_map<string,bool>& mp, int idx) {
        if(idx >= s.size()) return true;

        for(int i = idx; i < s.size(); i++) {
            string word = s.substr(idx, i - idx + 1);

            if(mp[word] == true && solve(s, mp, i + 1))
                return true;
        }

        return false;
    }

    bool wordBreak(string s, vector<string>& wordDict) {
        unordered_map<string,bool> mp;

        for(int i = 0; i < wordDict.size(); i++) {
            mp[wordDict[i]] = true;
        }

        vector<int> dp(s.size(), -1);

        return solveMem(s, mp, 0, dp);
    }
};
