class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        vector<int>ans;
        vector<int>temp;
        stack<int>s;
        s.push(-1);
        // temp.push_back(-1);

        int n=nums2.size();
        for(int i=n-1;i>=0;i--){
            if(i==n-1){
                temp.push_back(-1);
                s.push(nums2[i]);
            }
            else if(nums2[i]>=s.top()){
                while(s.top()!=-1 && nums2[i]>=s.top()){
                    s.pop();
                }
                if(s.top()==-1){
                    temp.push_back(s.top());
                    s.push(nums2[i]);
                }
                else{
                    temp.push_back(s.top());
                    s.push(nums2[i]);
                }
            }
            else{
                temp.push_back(s.top());
                s.push(nums2[i]);
            }
        }
        reverse (temp.begin(),temp.end());
        for(int i=0;i<nums1.size();i++){
            bool found=false;
            for(int j=0;j<nums2.size();j++){
                if(nums1[i]==nums2[j]){
                    found=true;
                    ans.push_back(temp[j]);
                    break;
                }
            }
            if(!found){
                ans.push_back(-1);
            }
        }
        return ans;
    }
};
